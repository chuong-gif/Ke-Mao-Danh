      m_Calls: []
  m_text: "K\u1EBA M\u1EA0O DANH\n\nNh\xF3m th\u1EF1c hi\u1EC7n:\n2312607 - Nguy\u1EC5n
    Ng\u1ECDc H\xE2n\n2312697 - Nguy\u1EC5n Th\u1ECB Tr\u01B0\u1EDDng Nga\n2312588
    - Ng\xF4 V\u0103n Ch\u01B0\u01A1ng\r\n\r\nC\u1ED1t truy\u1EC7n:\r\nTrong m\u1ED9t
    tr\u1EA1m kh\xF4ng gian b\u1ECB c\xF4 l\u1EADp, c\xE1c phi h\xE0nh gia ph\u1EA3i
    ph\u1ED1i h\u1EE3p ho\xE0n th\xE0nh nhi\u1EC7m v\u1EE5 \u0111\u1EC3 duy tr\xEC
    ho\u1EA1t \u0111\u1ED9ng c\u1EE7a con t\xE0u. Tuy nhi\xEAn, trong nh\xF3m c\xF3
    k\u1EBB m\u1EA1o danh \u0111ang \xE2m th\u1EA7m t\xECm c\xE1ch ph\xE1 ho\u1EA1i
    v\xE0 ti\xEAu di\u1EC7t phi h\xE0nh \u0111o\xE0n.\r\n\r\nNhi\u1EC7m v\u1EE5 c\u1EE7a
    Crewmate:\r\n- Ho\xE0n th\xE0nh c\xE1c nhi\u1EC7m v\u1EE5.\r\n- T\xECm ra k\u1EBB
    m\u1EA1o danh.\r\n- B\xE1o c\xE1o x\xE1c ch\u1EBFt.\r\n\r\nNhi\u1EC7m v\u1EE5
    c\u1EE7a Impostor:\r\n- Gi\u1EA3 l\xE0m phi h\xE0nh \u0111o\xE0n.\r\n- Ti\xEAu
    di\u1EC7t Crewmate.\r\n- G\xE2y nhi\u1EC5u v\xE0 che gi\u1EA5u th\xE2n ph\u1EADn.\r\n"
